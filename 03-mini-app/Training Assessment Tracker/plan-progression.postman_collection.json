{
  "info": {
    "name": "Training Tracker — Plan Progression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set variables to a disposable draft plan with baselines, its administrator token, and its exact baseline skill IDs. Run manually. Completion requires all existing weeks closed. Repeated transitions should return 409."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "plan_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "skill_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "activate",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/plans/{{plan_id}}/activate",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "complete",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/plans/{{plan_id}}/complete",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"finals\":[{\"skill_id\":{{skill_id}},\"score\":85}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ]
}
