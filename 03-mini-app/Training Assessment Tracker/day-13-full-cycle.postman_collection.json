        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Exact delta and retired history\", () => { const row=pm.response.json().data[0]; pm.expect(row.delta).to.eql(\"24.85\"); pm.expect(row.is_active).to.eql(false); });"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
