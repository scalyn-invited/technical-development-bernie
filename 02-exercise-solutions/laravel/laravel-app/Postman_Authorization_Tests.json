{
  "info": {
    "name": "Laravel Sanctum Authorization Tests",
    "description": "Complete authorization breaking test suite for Day 8 Exercise",
    "version": "1.0.0"
  },
  "auth": null,
  "item": [
    {
      "name": "Setup - Get Tokens",
      "item": [
        {
          "name": "1. User A Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token_a', jsonData.token);",
                  "    pm.environment.set('user_a_id', jsonData.data.id);",
                  "    console.log('✅ Token A saved: ' + jsonData.token.substring(0, 20) + '...');",
                  "} else {",
                  "    console.log('❌ Login failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"employee@example.com\",\"password\":\"password\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          }
        },
        {
          "name": "2. Create Order - User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('order_id_a', jsonData.data.id);",
                  "    console.log('✅ Order A created: ' + jsonData.data.id);",
                  "} else {",
                  "    console.log('❌ Order creation failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_id\":1,\"total\":100.00,\"status\":\"pending\",\"placed_at\":\"2026-09-04 10:00:00\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "3. User B Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token_b', jsonData.token);",
                  "    pm.environment.set('user_b_id', jsonData.data.id);",
                  "    console.log('✅ Token B saved: ' + jsonData.token.substring(0, 20) + '...');",
                  "} else {",
                  "    console.log('❌ Register failed');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Jane Employee\",\"email\":\"jane@example.com\",\"password\":\"password123\",\"password_confirmation\":\"password123\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Test 1 - Cross-User Access",
      "item": [
        {
          "name": "Attack: User B tries to update User A's order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should return 403 Forbidden', function () {",
                  "    pm.expect(pm.response.code).to.equal(403);",
                  "});",
                  "",
                  "pm.test('Should NOT return order data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal(true);",
                  "    pm.expect(jsonData.code).to.equal('forbidden');",
                  "});",
                  "",
                  "pm.test('Should have generic error message (no info leak)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.equal('This action is unauthorized.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_b}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_id\":1,\"total\":9999.99,\"status\":\"completed\",\"placed_at\":\"2026-09-04 10:00:00\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id_a}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{order_id_a}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Test 2 - Token Revocation",
      "item": [
        {
          "name": "User A Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should logout successfully', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Should return success message', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('logged out');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "logout"
              ]
            }
          }
        },
        {
          "name": "Attack: Use revoked token after logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Revoked token should return 401', function () {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "",
                  "pm.test('Should return unauthenticated error', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal(true);",
                  "    pm.expect(jsonData.code).to.equal('unauthenticated');",
                  "});",
                  "",
                  "pm.test('Should NOT return user data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Test 3 - Malformed Tokens",
      "item": [
        {
          "name": "Attack: Garbage token (xyz-invalid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should reject garbage token with 401', function () {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "",
                  "pm.test('Should return unauthenticated error', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.equal('unauthenticated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer xyz-invalid-garbage-string"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Attack: Valid-format token from different app",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should reject wrong-app token with 401', function () {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "",
                  "pm.test('Should return unauthenticated error', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.equal('unauthenticated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer 1|ValidFormatButWrongApp"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Attack: No token at all",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should reject missing token with 401', function () {",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "",
                  "pm.test('Should return unauthenticated error', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.equal('unauthenticated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          }
        }
      ]
    },
