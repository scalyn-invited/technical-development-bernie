    {
      "name": "Test 5 - Valid Access",
      "item": [
        {
          "name": "User B can access their own order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User B can create and access their own order', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_b}}"
