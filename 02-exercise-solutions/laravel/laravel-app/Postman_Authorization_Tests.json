            }
          }
        },
        {
          "name": "Login Attempt 6 - Should be rate limited (429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('6th attempt should return 429 Too Many Requests', function () {",
                  "    pm.expect(pm.response.code).to.equal(429);",
                  "});",
                  "",
                  "pm.test('Should include retry-after header', function () {",
                  "    pm.expect(pm.response.headers.get('Retry-After')).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
