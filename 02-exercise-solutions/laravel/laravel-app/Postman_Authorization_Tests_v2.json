    {
      "name": "Setup - Get Tokens",
      "item": [
        {
          "name": "1. User A Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token_a', jsonData.token);",
                  "    pm.environment.set('user_a_id', jsonData.data.id);",
                  "    console.log('✅ Token A saved');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"employee@example.com\",\"password\":\"password\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "2. Create Order - User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('order_id_a', jsonData.data.id);",
                  "    console.log('✅ Order A created: ' + jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_id\":1,\"total\":100.00,\"status\":\"pending\",\"placed_at\":\"2026-09-04 10:00:00\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "3. User B Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token_b', jsonData.token);",
                  "    pm.environment.set('user_b_id', jsonData.data.id);",
                  "    console.log('✅ Token B saved');",
                  "}"
                ]
