    {
      "name": "Test 1 - Cross-User Access",
      "item": [
        {
          "name": "Attack: User B tries to update User A's order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Should return 403 Forbidden', function () {",
                  "    pm.expect(pm.response.code).to.equal(403);",
                  "});",
                  "",
                  "pm.test('Error code should be forbidden', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.equal(true);",
                  "    pm.expect(jsonData.code).to.equal('forbidden');",
                  "});",
                  "",
                  "pm.test('Should NOT leak order data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_b}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"customer_id\":1,\"total\":9999.99,\"status\":\"completed\",\"placed_at\":\"2026-09-04 10:00:00\"}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id_a}}",
              "protocol": "http",
              "host": ["{{base_url}}"],
              "path": ["api", "orders", "{{order_id_a}}"]
            }
          }
        }
      ]
    },
